<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/outline" />
        </shape>
    </item>
    <!-- Horizontal lines (using shape gradients for subtle effect) -->
    <item android:top="32dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#E0E0E0" />
        </shape>
    </item>
    <item android:top="64dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#E0E0E0" />
        </shape>
    </item>
    <item android:top="96dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#E0E0E0" />
        </shape>
    </item>
    <!-- Add more lines as needed for longer cards -->
</layer-list> 